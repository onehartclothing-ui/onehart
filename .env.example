# Copy to .env.local for local development (never commit real values).
# Add the same keys in Vercel → Project Settings → Environment Variables.

# Required — Shopify Headless channel (Storefront API)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional — Supabase checkout-session logging. Leave blank to disable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
